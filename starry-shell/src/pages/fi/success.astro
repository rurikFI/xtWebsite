---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
---

<script>localStorage.removeItem('xt_kit'); localStorage.removeItem('xt_email_captured');</script>

<Layout title="Tilaus vahvistettu — Xtruder™" lang="fi">
  <main class="min-h-screen bg-[#0F172A] flex items-center justify-center px-4">
    <div class="text-center max-w-lg">
      <div class="flex items-center justify-center gap-2 mb-10">
        <img src="/favicon.webp" alt="" class="h-8 w-8 rounded-md object-cover" />
        <img src="/logo.png" alt="Xtruder™" class="h-7 w-auto" />
      </div>

      <div class="text-6xl mb-6">🎉</div>

      <h1 class="font-heading text-4xl md:text-5xl font-black text-white mb-4">
        Tilaus <span class="text-gradient">Vahvistettu!</span>
      </h1>

      <p class="text-slate-300 text-lg mb-3">
        Kiitos tilauksestasi. Mukautettu Xtruder-pakettisi on valmisteilla.
      </p>
      <p class="text-slate-500 text-sm mb-10">
        Saat pian sähköpostivahvistuksen tilauksesi tiedoilla.
      </p>

      <div class="bg-white/[0.04] border border-white/10 rounded-2xl p-6 mb-10 text-left space-y-3">
        <div class="flex items-center gap-3 text-slate-300 text-sm">
          <svg class="w-5 h-5 text-brand flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Maksu vastaanotettu ja vahvistettu
        </div>
        <div class="flex items-center gap-3 text-slate-300 text-sm">
          <svg class="w-5 h-5 text-brand flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Mukautetut kokosi on kirjattu tuotantoa varten
        </div>
        <div class="flex items-center gap-3 text-slate-300 text-sm">
          <svg class="w-5 h-5 text-brand flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          Vahvistussähköposti on matkalla sinulle
        </div>
      </div>

      <a href="/fi/" class="inline-flex items-center gap-2 bg-brand hover:bg-brand-hover text-white font-bold px-8 py-4 rounded-xl transition-colors duration-200">
        Takaisin etusivulle
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </main>
</Layout>
