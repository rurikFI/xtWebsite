---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PostiPickupSelector from '../../components/PostiPickupSelector.astro';
import '../../styles/global.css';
---

<Layout title="Rakenna pakettisi — Xtruder™" lang="fi">
  <Navbar lang="fi" />

  <main class="min-h-screen bg-slate-50 dark:bg-[#0F172A] pt-24 pb-20 transition-colors duration-300">
    <div class="fixed inset-0 opacity-[0.04] pointer-events-none z-0">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-byk" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-byk)"/>
      </svg>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="text-center mb-14">
        <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-3 block">Mukautettu tilaus</span>
        <h1 class="font-heading text-4xl md:text-5xl font-black text-slate-900 dark:text-white mb-4">
          Rakenna <span class="text-gradient">pakettisi</span>
        </h1>
        <p class="text-slate-500 dark:text-slate-400 text-lg max-w-xl mx-auto">
          Kerro meille tarvitsemasi tarkat koot. Jokainen Xtruder valmistetaan tekniikkasi mukaan.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 items-start">

        <!-- LEFT: Tuotetiedot -->
        <div class="space-y-6 order-2 lg:order-1">

          <div class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/10 rounded-2xl p-7 shadow-sm dark:shadow-none">
            <h2 class="font-heading text-xl text-slate-900 dark:text-white mb-4">Mitä tilaat</h2>
            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed mb-5">
              Xtruder™ on patentoitu eristys- ja pinnoitustyökalu, joka levittää materiaalit tasaisesti putkien, kaapelien ja letkujen ympärille koosta riippumatta. Jokainen yksikkö on räätälöity ilmoittamallesi halkaisijalle — täydellinen istuvuus joka kerta.
            </p>
            <div class="space-y-3">
              {[
                ['Patentoitu suomalainen insinööriosaaminen', 'Suunniteltu ja valmistettu Suomessa korkeimman standardin mukaan.'],
                ['Räätälöity kokosi mukaan', 'Ilmoitat halkaisijan mm tai tuumina — me rakennamme sen tarkasti.'],
                ['Toimii kaikilla pyöreillä pinnoilla', 'Putket, kaapelit, letkut, kanavat — jos se on pyöreä, se sopii.'],
                ['Volyymihinnoittelu sisältyy', 'Mitä enemmän tilaat, sitä parempi hinta per yksikkö.'],
              ].map(([title, body]) => (
                <div class="flex gap-3">
                  <svg class="w-5 h-5 text-brand flex-shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  <div>
                    <p class="text-slate-800 dark:text-white text-sm font-semibold">{title}</p>
                    <p class="text-slate-500 dark:text-slate-400 text-sm">{body}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/10 rounded-2xl p-7 shadow-sm dark:shadow-none">
            <h2 class="font-heading text-xl text-slate-900 dark:text-white mb-4">Volyymihinnasto</h2>
            <div class="space-y-2.5">
              {[
                ['1–2 yksikköä',   '€29.99 / yksikkö', false, false, 'TÄYSI HINTA', false],
                ['3–5 yksikköä',   '€26.99 / yksikkö', true,  false, '-10%',        false],
                ['6–9 yksikköä',   '€22.49 / yksikkö', true,  false, '-25%',        false],
                ['10–20 yksikköä', '€20.99 / yksikkö', true,  true,  '-30%',        true ],
              ].map(([range, price, disc, best, label, isBest]) => (
                <div class={`flex items-center justify-between rounded-xl px-4 py-3 ${best ? 'bg-brand/10 border border-brand/30' : 'bg-slate-50 dark:bg-white/[0.03] border border-slate-100 dark:border-white/[0.06]'}`}>
                  <div class="flex items-center gap-2">
                    <span class={`text-sm font-medium ${best ? 'text-brand' : 'text-slate-600 dark:text-slate-300'}`}>{range}</span>
                    <span class={`text-xs font-bold px-2 py-0.5 rounded-full ${isBest ? 'bg-brand text-white' : best ? 'text-brand' : disc ? 'text-green-600 dark:text-green-400' : 'text-slate-400 dark:text-slate-500'}`}>{label}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    {disc && <span class="text-xs text-slate-400 dark:text-slate-500 line-through">€29.99</span>}
                    <span class={`text-sm font-bold ${best ? 'text-brand' : 'text-slate-800 dark:text-white'}`}>{price}</span>
                  </div>
                </div>
              ))}
            </div>
            <p class="text-slate-400 dark:text-slate-500 text-xs mt-4">Kaikki hinnat euroissa. Vero lasketaan kassalla.</p>
          </div>

          <div id="email-capture-box" class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/10 rounded-2xl p-7 shadow-sm dark:shadow-none">
            <div id="email-capture-form">
              <div class="bg-brand/10 border border-brand/30 rounded-xl px-4 py-3 mb-5">
                <p class="text-brand font-bold text-2xl" style="font-family:'Racing Sans One',sans-serif;">30% ALE</p>
                <p class="text-slate-600 dark:text-slate-300 text-sm mt-0.5 uppercase tracking-wide font-semibold">Eksklusiivinen alennus <span class="normal-case text-xs font-normal">— vain uusille asiakkaille</span></p>
              </div>
              <p class="text-slate-800 dark:text-white font-semibold text-sm mb-4">Rekisteröi sähköpostisi ja saa alennuksesi!</p>
              <div class="flex gap-2">
                <input
                  id="kit-email-input"
                  type="email"
                  placeholder="sinä@esimerkki.com"
                  class="flex-1 min-w-0 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-white/10 focus:border-brand/60 rounded-xl px-4 py-2.5 text-slate-800 dark:text-slate-200 text-sm placeholder-slate-400 dark:placeholder-slate-500 outline-none transition-colors duration-200"
                />
                <button id="kit-email-submit" class="bg-brand hover:bg-brand-hover text-white font-semibold text-sm rounded-xl px-4 py-2.5 transition-colors duration-200 whitespace-nowrap cursor-pointer">
                  Saa tarjous
                </button>
              </div>
            </div>
            <div id="email-capture-success" class="hidden text-center py-2">
              <p class="text-4xl mb-3">🎉</p>
              <p class="text-slate-800 dark:text-white font-semibold text-lg" style="font-family:'Racing Sans One',sans-serif;">Sinulla on tarjous!</p>
              <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Se aktivoituu automaattisesti kassalla.</p>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3">
            {[
              ['🇫🇮', 'Valmistettu Suomessa'],
              ['🔒', 'Turvallinen kassa'],
              ['📦', 'Toimitus maailmanlaajuisesti'],
            ].map(([icon, label]) => (
              <div class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/10 rounded-xl p-4 text-center shadow-sm dark:shadow-none">
                <p class="text-2xl mb-1">{icon}</p>
                <p class="text-slate-500 dark:text-slate-400 text-xs font-medium">{label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- RIGHT: Paketin rakentaja -->
        <div class="bg-white dark:bg-white/[0.03] border border-slate-200 dark:border-white/10 rounded-2xl p-7 lg:sticky lg:top-28 order-1 lg:order-2 shadow-sm dark:shadow-none">

          <h2 class="font-heading text-xl text-slate-900 dark:text-white mb-1">Sinun Xtruderisi</h2>
          <p class="text-slate-500 dark:text-slate-400 text-sm mb-6">Syötä halkaisija kullekin tarvitsemallesi Xtruderille.</p>

          <div id="size-inputs" class="space-y-3 mb-4"></div>

          <div class="relative w-full mb-6">
            <svg class="add-xtruder-border absolute inset-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
              <rect class="add-xtruder-rect" x="0.5" y="0.5" width="calc(100% - 1px)" height="calc(100% - 1px)" rx="11.5" ry="11.5" fill="none" style="stroke: var(--dash-stroke)" stroke-width="1" stroke-dasharray="6 4"/>
            </svg>
            <button
              id="add-xtruder"
              class="w-full flex items-center justify-center gap-2 text-slate-400 hover:text-brand text-sm font-medium rounded-xl px-4 py-3 transition-colors duration-200 cursor-pointer"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
              </svg>
              LISÄÄ XTRUDER
            </button>
          </div>

          <div id="persuasion" class="hidden bg-brand/10 border border-brand/30 rounded-xl px-4 py-3 mb-6 text-sm text-slate-700 dark:text-slate-200 leading-relaxed"></div>

          <div class="bg-slate-50 dark:bg-white/[0.04] border border-slate-200 dark:border-white/10 rounded-xl p-4 mb-5 space-y-2">
            <div class="flex justify-between text-sm text-slate-500 dark:text-slate-400">
              <span>Yksiköt</span>
              <span id="summary-qty">0</span>
            </div>
            <div class="flex justify-between text-sm text-slate-500 dark:text-slate-400">
              <span>Hinta per yksikkö</span>
              <span id="summary-unit">€29.99</span>
            </div>
            <div id="summary-discount-row" class="hidden flex justify-between text-sm text-green-600 dark:text-green-400">
              <span id="summary-discount-label">Alennus</span>
              <span id="summary-discount-amt"></span>
            </div>
            <div class="border-t border-slate-200 dark:border-white/10 pt-2 flex justify-between text-slate-900 dark:text-white font-bold">
              <span>Yhteensä</span>
              <span id="summary-total">€0.00</span>
            </div>
          </div>

          <!-- Posti pickup point selector -->
          <div class="mb-5">
            <PostiPickupSelector lang="fi" />
          </div>

          <button id="checkout-btn" disabled class="w-full bg-brand hover:bg-brand-hover disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer text-white font-bold text-base rounded-xl px-6 py-4 transition-colors duration-200 flex items-center justify-center gap-2">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
            </svg>
            Siirry kassalle
          </button>
          <p class="text-slate-400 dark:text-slate-600 text-xs text-center mt-3">Stripe-maksut · 256-bittinen SSL</p>
        </div>

      </div>
    </div>
  </main>

  <Footer lang="fi" />
</Layout>

<script>
  const BASE = 29.99;
  type UnitType = 'mm' | 'in';

  function getUnitPrice(qty: number): number {
    if (qty >= 10) return parseFloat((BASE * 0.70).toFixed(2));
    if (qty >= 6)  return parseFloat((BASE * 0.75).toFixed(2));
    if (qty >= 3)  return parseFloat((BASE * 0.90).toFixed(2));
    return BASE;
  }

  function getDiscountPct(qty: number): number {
    if (qty >= 10) return 30;
    if (qty >= 6)  return 25;
    if (qty >= 3)  return 10;
    return 0;
  }

  function persuasionText(qty: number): string {
    if (qty === 0) return '';
    if (qty === 1) return '💡 Lisää toinen Xtruder kattamaan enemmän kokoja — vielä täyteen hintaan. Tai lisää yksi lisää ja saa 10% alennus koko tilauksestasi!';
    if (qty === 2) return '🔥 Lisää vain yksi Xtruder lisää ja saa 10% alennus koko tilauksestasi!';
    if (qty >= 3 && qty <= 5) {
      const need = 6 - qty;
      return `🔥 Lisää ${need} Xtruder${need > 1 ? 'ia' : ''} lisää ja saa 25% alennus koko tilauksestasi — olet melkein perillä!`;
    }
    if (qty >= 6 && qty <= 9) {
      const need = 10 - qty;
      return `🏆 Lisää ${need} lisää ja saa PARAS tarjouksemme — 30% alennus koko tilauksestasi!`;
    }
    if (qty >= 10) return '🏆 Paras tarjous avattu! Saat 30% alennuksen koko tilauksestasi.';
    return '';
  }

  let count = 0;
  const inputsList = document.getElementById('size-inputs')!;
  const addBtn = document.getElementById('add-xtruder') as HTMLButtonElement;
  const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
  const persuasionEl = document.getElementById('persuasion')!;

  function getDefaultUnit(): UnitType {
    const first = inputsList.querySelector<HTMLElement>('.unit-toggle');
    return (first?.dataset.unit as UnitType) ?? 'mm';
  }

  function setUnitToggle(btn: HTMLElement, unit: UnitType) {
    btn.dataset.unit = unit;
    const mmEl = btn.querySelector('[data-label="mm"]')!;
    const inEl = btn.querySelector('[data-label="in"]')!;
    mmEl.className = unit === 'mm'
      ? 'px-1.5 rounded-lg bg-brand text-white text-xs font-bold transition-all duration-150 flex items-center'
      : 'px-1.5 rounded-lg text-slate-400 text-xs font-medium transition-all duration-150 hover:text-slate-600 flex items-center';
    inEl.className = unit === 'in'
      ? 'px-1.5 rounded-lg bg-brand text-white text-xs font-bold transition-all duration-150 flex items-center'
      : 'px-1.5 rounded-lg text-slate-400 text-xs font-medium transition-all duration-150 hover:text-slate-600 flex items-center';
  }

  function addInput(value = '', unit: UnitType | null = null) {
    if (count >= 20) return;
    count++;
    const idx = count;
    const resolvedUnit: UnitType = unit ?? getDefaultUnit();
    const row = document.createElement('div');
    row.className = 'flex items-center gap-2';
    row.id = `size-row-${idx}`;
    row.innerHTML = `
      <span class="text-slate-400 text-sm w-5 text-right flex-shrink-0">${idx}.</span>
      <input type="text" id="size-input-${idx}" inputmode="decimal" placeholder="esim. 25"
        class="size-field flex-1 min-w-0 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-white/10 focus:border-brand/60 rounded-xl px-4 py-2.5 text-slate-800 dark:text-slate-200 text-sm placeholder-slate-400 dark:placeholder-slate-500 outline-none transition-colors duration-200"/>
      <button type="button" data-unit="${resolvedUnit}" class="unit-toggle flex-shrink-0 self-stretch flex items-stretch bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-white/10 rounded-xl px-1 py-1 gap-0.5 cursor-pointer">
        <span data-label="mm" class="">mm</span>
        <span data-label="in" class="">in</span>
      </button>
      ${idx > 1 ? `<button type="button" data-remove="${idx}" class="remove-btn text-slate-400 hover:text-red-400 transition-colors duration-200 flex-shrink-0">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>` : '<span class="w-4 flex-shrink-0"></span>'}
    `;
    inputsList.appendChild(row);
    const toggleBtn = row.querySelector<HTMLElement>('.unit-toggle')!;
    setUnitToggle(toggleBtn, resolvedUnit);
    toggleBtn.addEventListener('click', () => {
      setUnitToggle(toggleBtn, (toggleBtn.dataset.unit as UnitType) === 'mm' ? 'in' : 'mm');
      update();
    });
    row.querySelector('.remove-btn')?.addEventListener('click', (e) => {
      document.getElementById(`size-row-${(e.currentTarget as HTMLElement).dataset.remove!}`)?.remove();
      recount(); update();
    });
    const inputEl = row.querySelector<HTMLInputElement>('input')!;
    inputEl.value = value;
    inputEl.addEventListener('input', () => {
      let v = inputEl.value.replace(/[^0-9.,]/g, '');
      const firstSep = v.search(/[.,]/);
      if (firstSep !== -1) v = v.slice(0, firstSep + 1) + v.slice(firstSep + 1).replace(/[.,]/g, '');
      if (inputEl.value !== v) inputEl.value = v;
      update();
    });
    if (count >= 20) addBtn.classList.add('opacity-40', 'cursor-not-allowed');
    update();
  }

  function recount() {
    const rows = inputsList.querySelectorAll('[id^="size-row-"]');
    rows.forEach((row, i) => { const n = row.querySelector('span:first-child'); if (n) n.textContent = String(i + 1) + '.'; });
    count = rows.length;
    addBtn.classList.toggle('opacity-40', count >= 20);
    addBtn.classList.toggle('cursor-not-allowed', count >= 20);
  }

  function getSizes(): string[] {
    return Array.from(inputsList.querySelectorAll<HTMLElement>('[id^="size-row-"]'))
      .map(row => {
        const val = row.querySelector<HTMLInputElement>('.size-field')!.value.replace(',', '.').trim();
        const unit = row.querySelector<HTMLElement>('.unit-toggle')?.dataset.unit ?? 'mm';
        return val ? `${val} ${unit}` : '';
      }).filter(Boolean);
  }

  function saveKit() {
    const data = Array.from(inputsList.querySelectorAll<HTMLElement>('[id^="size-row-"]')).map(row => ({
      value: row.querySelector<HTMLInputElement>('.size-field')!.value,
      unit: (row.querySelector<HTMLElement>('.unit-toggle')?.dataset.unit ?? 'mm') as UnitType,
    }));
    localStorage.setItem('xt_kit', JSON.stringify(data));
  }

  function update() {
    const sizes = getSizes();
    const qty = sizes.length;
    const unitPrice = getUnitPrice(qty);
    const pct = getDiscountPct(qty);
    document.getElementById('summary-qty')!.textContent = String(qty);
    document.getElementById('summary-unit')!.textContent = `€${unitPrice.toFixed(2)}`;
    document.getElementById('summary-total')!.textContent = qty > 0 ? `€${(unitPrice * qty).toFixed(2)}` : '€0.00';
    const discRow = document.getElementById('summary-discount-row')!;
    if (pct > 0 && qty > 0) {
      document.getElementById('summary-discount-label')!.textContent = `${pct}% alennus`;
      document.getElementById('summary-discount-amt')!.textContent = `-€${((BASE - unitPrice) * qty).toFixed(2)}`;
      discRow.classList.remove('hidden');
    } else { discRow.classList.add('hidden'); }
    const msg = persuasionText(qty);
    if (msg) { persuasionEl.textContent = msg; persuasionEl.classList.remove('hidden'); }
    else { persuasionEl.classList.add('hidden'); }
    checkoutBtn.disabled = qty === 0;
    saveKit();
  }

  addBtn.addEventListener('click', () => { if (count < 20) addInput(); });

  checkoutBtn.addEventListener('click', async () => {
    const sizes = getSizes();
    if (!sizes.length) return;
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Siirrytään kassalle…';
    const pickup = (window as any).getPostiPickupPoint?.() ?? null;
    try {
      const res = await fetch('/api/create-checkout.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ sizes, lang: 'fi', pickupPointId: pickup?.id ?? '', pickupLabel: pickup?.name ?? '' }),
      });
      const data = await res.json();
      if (data.url) { window.location.href = data.url; } else { throw new Error(); }
    } catch {
      checkoutBtn.disabled = false;
      checkoutBtn.innerHTML = `<svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg> Siirry kassalle`;
      alert('Jotain meni pieleen. Yritä uudelleen.');
    }
  });

  const kitEmailInput = document.getElementById('kit-email-input') as HTMLInputElement;
  const kitEmailSubmit = document.getElementById('kit-email-submit') as HTMLButtonElement;
  if (localStorage.getItem('xt_email_captured')) {
    document.getElementById('email-capture-form')!.classList.add('hidden');
    document.getElementById('email-capture-success')!.classList.remove('hidden');
  }
  kitEmailSubmit.addEventListener('click', async () => {
    const email = kitEmailInput.value.trim();
    if (!email || !email.includes('@')) { kitEmailInput.focus(); return; }
    kitEmailSubmit.disabled = true; kitEmailSubmit.textContent = '…';
    try { await fetch('/api/subscribe.php', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email }) }); } catch {}
    localStorage.setItem('xt_email_captured', '1');
    document.getElementById('email-capture-form')!.classList.add('hidden');
    document.getElementById('email-capture-success')!.classList.remove('hidden');
  });
  kitEmailInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') kitEmailSubmit.click(); });

  const saved = localStorage.getItem('xt_kit');
  let savedRows: { value: string; unit: UnitType }[] = [];
  try { savedRows = saved ? JSON.parse(saved) : []; } catch { savedRows = []; }
  if (savedRows.length > 0) { savedRows.forEach(({ value, unit }) => addInput(value, unit)); update(); }
  else { addInput(); }
</script>

<style>
  @keyframes march-dashes {
    to { stroke-dashoffset: -20; }
  }
  .add-xtruder-rect {
    animation: march-dashes 3s linear infinite;
    transition: stroke 0.2s;
  }
  div:has(#add-xtruder:hover) .add-xtruder-rect {
    stroke: rgba(232, 73, 12, 0.5) !important;
  }
</style>
