---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="Shipping Policy — Xtruder Tools">
  <Navbar />

  <section class="bg-white dark:bg-slate-950 pt-32 pb-14 px-4">
    <div class="max-w-3xl mx-auto">
      <p class="text-brand text-sm font-semibold uppercase tracking-widest mb-3">Legal</p>
      <h1 class="text-slate-900 dark:text-white font-heading text-4xl font-bold">Shipping &amp; Delivery Policy</h1>
      <p class="text-slate-400 mt-3 text-sm">Last updated April 28, 2023</p>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto space-y-8 text-slate-600 leading-relaxed">

      <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Shipping Options</h2>

      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
          <p class="font-heading font-bold text-slate-900 text-lg">Free Standard Shipping</p>
          <p class="text-slate-500 text-sm mt-1">On orders over 100 €, including international orders.</p>
        </div>
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-5">
          <p class="font-heading font-bold text-slate-900 text-lg">Posti Expedited</p>
          <p class="text-slate-500 text-sm mt-1">4–6 business days · 6–15 €</p>
        </div>
      </div>

      <p class="text-sm text-slate-500 italic">All delivery times and dates are estimates provided in good faith. For EU and UK consumers, deliveries occur within 30 days of order acceptance.</p>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">International Delivery</h2>
        <p>We offer worldwide shipping. Free standard shipping applies to international orders. Customers may be subject to additional taxes and duties depending on their location — recipients are responsible for compliance with applicable local laws and any associated costs.</p>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Delivery Schedule</h2>
        <p>We deliver <strong class="text-slate-800">Monday – Friday</strong>.</p>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Delayed Orders</h2>
        <p>If your order is delayed, you will be notified promptly with a revised delivery estimate.</p>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Returns</h2>
        <p>Review our <a href="/return-policy/" class="text-brand hover:underline">Return Policy</a> for information on returning items.</p>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Contact Us</h2>
        <p>Questions about shipping? Reach out at <a href="mailto:support@xtrudertools.com" class="text-brand hover:underline">support@xtrudertools.com</a> or via our <a href="/contact-us/" class="text-brand hover:underline">contact form</a>.</p>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
