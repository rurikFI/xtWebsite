---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout title="Return Policy — Xtruder Tools">
  <Navbar />

  <section class="bg-white dark:bg-slate-950 pt-32 pb-14 px-4">
    <div class="max-w-3xl mx-auto">
      <p class="text-brand text-sm font-semibold uppercase tracking-widest mb-3">Legal</p>
      <h1 class="text-slate-900 dark:text-white font-heading text-4xl font-bold">Return Policy</h1>
    </div>
  </section>

  <section class="bg-white py-16 px-4">
    <div class="max-w-3xl mx-auto space-y-8 text-slate-600 leading-relaxed">

      <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
        <p class="text-2xl font-heading font-bold text-slate-900">14-day returns</p>
        <p class="text-slate-500 mt-1">Refunds accepted within 14 days of receiving your item, for any reason.</p>
      </div>

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Eligibility for Refunds</h2>
        <p>Within 14 days from the date you received your item, you may request a refund for any reason. No questions asked.</p>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Return Shipping</h2>
        <p>Please send the item(s) to the following address:</p>
        <address class="not-italic bg-slate-50 border border-slate-200 rounded-xl p-6 text-slate-700 space-y-1 mt-4">
          <p class="font-semibold text-slate-900">Xtruder Tools AB</p>
          <p>Slaeten 1</p>
          <p>Vaenoxa, 25910</p>
          <p>Finland</p>
        </address>
        <ul class="list-disc list-outside ml-5 space-y-2 mt-4">
          <li>You are responsible for paying your own shipping costs for returning the item.</li>
          <li>Shipping costs are non-refundable. If you receive a refund, the cost of return shipping will be deducted from your refund.</li>
        </ul>
      </div>

      <hr class="border-slate-200" />

      <div>
        <h2 class="font-heading text-2xl font-bold text-slate-900 mb-4">Questions?</h2>
        <p>
          Contact us at <a href="mailto:support@xtrudertools.com" class="text-brand hover:underline">support@xtrudertools.com</a> — we'll gladly help.
        </p>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
