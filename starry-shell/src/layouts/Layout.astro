---
import type { Lang } from '../i18n/translations';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  viewport?: string;
}
const {
  title = "Xtruder™ — Insulate in a New, Efficient Way",
  description = "The Xtruder™ — Patented insulation and coating tool. Apply materials uniformly around pipes, cables, hoses, and more. Made in Finland.",
  lang = 'en',
  viewport = 'width=device-width, initial-scale=1.0',
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content={viewport} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Racing+Sans+One&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const t = localStorage.getItem('xt-theme') ?? 'dark';
      if (t === 'dark') document.documentElement.classList.add('dark');
      else document.documentElement.classList.remove('dark');
    </script>
    <style is:global>
      body { font-family: 'Nunito Sans', sans-serif; }
    </style>
  </head>
  <body class="bg-white dark:bg-[#0F172A] text-slate-700 transition-colors duration-300">
    <slot />
  </body>
</html>
