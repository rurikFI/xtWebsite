---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].materials;

const materialData = [
  { bg: "bg-amber-100", iconColor: "text-amber-600", icon: `<path d="M12 2a10 10 0 100 20A10 10 0 0012 2z"/><path d="M12 8v8M8 12h8"/>` },
  { bg: "bg-blue-100",  iconColor: "text-blue-600",  icon: `<path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="4"/>` },
  { bg: "bg-green-100", iconColor: "text-green-600", icon: `<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>` },
  { bg: "bg-teal-100",  iconColor: "text-teal-600",  icon: `<path d="M12 22a7 7 0 007-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 007 7z"/>` },
  { bg: "bg-orange-100",iconColor: "text-brand",     icon: `<path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>` },
  { bg: "bg-slate-100", iconColor: "text-slate-600", icon: `<path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/>` },
];
const materials = materialData.map((d, i) => ({ ...d, name: t.names[i] }));
---

<section id="materials" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">

      <div class="reveal">
        <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-4 block">{t.label}</span>
        <h2 class="font-heading text-4xl md:text-5xl font-black text-slate-900 mb-6 leading-tight">
          {t.h2}<br/>{t.h2sub}
        </h2>
        <p class="text-slate-500 text-lg leading-relaxed mb-8">
          {t.body}
        </p>
        <a href="#cta" class="inline-flex items-center gap-2 bg-brand hover:bg-brand-hover text-white font-semibold px-6 py-3 rounded-xl transition-colors duration-200 cursor-pointer">
          {t.cta}
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 reveal reveal-d2">
        {materials.map(({ bg, iconColor, name, icon }) => (
          <div class="card-hover bg-slate-50 rounded-2xl p-5 text-center border border-slate-100 cursor-default">
            <div class={`w-10 h-10 ${bg} rounded-xl flex items-center justify-center mx-auto mb-3`}>
              <svg class={`w-5 h-5 ${iconColor}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </div>
            <span class="font-heading font-bold text-slate-800 text-sm">{name}</span>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
