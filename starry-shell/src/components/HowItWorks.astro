---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].howItWorks;

const steps = [
  { n: "1", accent: true,  title: t.steps[0].title, body: t.steps[0].body },
  { n: "2", accent: false, title: t.steps[1].title, body: t.steps[1].body },
  { n: "3", accent: false, title: t.steps[2].title, body: t.steps[2].body },
  { n: "4", accent: true,  title: t.steps[3].title, body: t.steps[3].body },
];
---

<section id="how-it-works" class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-16 reveal">
      <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-4 block">{t.label}</span>
      <h2 class="font-heading text-4xl md:text-5xl font-black text-slate-900 mb-4">
        {t.h2}<br/>{t.h2sub}
      </h2>
      <p class="text-slate-500 text-lg max-w-xl mx-auto">
        {t.body}
      </p>
    </div>

    <div class="grid md:grid-cols-4 gap-8 md:gap-6">
      {steps.map(({ n, accent, title, body }, i) => (
        <div class={`relative text-center reveal reveal-d${i + 1}`}>
          <div class={`w-16 h-16 ${accent ? 'bg-brand shadow-orange-200' : 'bg-[#64748B] shadow-slate-200'} rounded-2xl flex items-center justify-center mx-auto mb-5 shadow-lg`}>
            <span class="font-heading font-black text-white text-2xl">{n}</span>
          </div>
          {i < 3 && (
            <div class={`hidden md:block absolute top-8 left-[calc(50%+32px)] right-0 h-px bg-gradient-to-r ${accent ? 'from-brand/40 to-slate-200' : i === 2 ? 'from-slate-300 to-brand/40' : 'from-slate-300 to-slate-200'}`}></div>
          )}
          <h3 class="font-heading font-bold text-slate-900 text-lg mb-2">{title}</h3>
          <p class="text-slate-500 text-sm leading-relaxed">{body}</p>
        </div>
      ))}
    </div>

    <!-- Result banner -->
    <div class="mt-16 bg-gradient-to-r from-[#0F172A] to-[#1E293B] rounded-3xl p-8 md:p-12 text-center reveal">
      <div class="w-14 h-14 bg-brand/20 border border-brand/40 rounded-full flex items-center justify-center mx-auto mb-5">
        <svg class="w-7 h-7 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <h3 class="font-heading text-3xl font-black text-white mb-3">{t.resultTitle}</h3>
      <p class="text-slate-400 text-lg max-w-xl mx-auto">{t.resultBody}</p>
    </div>

  </div>
</section>
