---
const links = [
  { href: "#how-it-works", label: "How It Works" },
  { href: "#features", label: "Features" },
  { href: "#for-you", label: "Who It's For" },
  { href: "#materials", label: "Materials" },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 px-4 py-4">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-2 cursor-pointer">
      <img src="/favicon.webp" alt="" class="h-6 w-6 md:h-8 md:w-8 rounded-md object-cover flex-shrink-0 self-center" />
      <img src="/logo.png" alt="Xtruder™" class="h-6 md:h-8 w-auto" />
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-8">
      {links.map(({ href, label }) => (
        <a href={href} class="text-slate-300 hover:text-white transition-colors duration-200 text-sm font-medium cursor-pointer">
          {label}
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <a href="#cta" class="hidden sm:block text-sm text-slate-300 hover:text-white transition-colors duration-200 font-medium cursor-pointer">
        View Kits
      </a>
      <a href="#cta" class="bg-brand hover:bg-brand-hover text-white font-semibold text-sm px-5 py-2.5 rounded-lg transition-colors duration-200 cursor-pointer whitespace-nowrap">
        Buy Now
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar')!;
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 50);
  }, { passive: true });

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', (e) => {
      const href = (anchor as HTMLAnchorElement).getAttribute('href')!;
      const target = document.querySelector(href);
      if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
    });
  });
</script>
