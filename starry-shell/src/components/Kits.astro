---
const kits = [
  {
    name: "Core Kit",
    price: "€69.90",
    range: "2–15 mm",
    count: 6,
    desc: "Essential sizes for wiring and small tubing.",
    tag: null,
    highlight: false,
  },
  {
    name: "Extended Kit",
    price: "€109.90",
    range: "6–35 mm",
    count: 9,
    desc: "Covers standard plumbing diameters. The most popular choice.",
    tag: "Most Popular",
    highlight: true,
  },
  {
    name: "Full Kit",
    price: "€149.90",
    range: "2–54 mm",
    count: 13,
    desc: "Complete size set for professional daily use.",
    tag: "Best Value",
    highlight: false,
  },
];
---

<section id="kits" class="py-24 bg-[#0F172A] relative overflow-hidden">
  <!-- subtle grid -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid-kits" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid-kits)"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <span class="text-[#F97316] font-semibold text-sm uppercase tracking-widest mb-3 block">Kits & Pricing</span>
      <h2 class="font-heading text-4xl md:text-5xl font-black text-white mb-4 leading-tight">
        Choose Your <span class="text-gradient">Xtruder Kit</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-xl mx-auto">
        Every kit ships with individually sized Xtruders. Pick the range that matches your work.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6">
      {kits.map(({ name, price, range, count, desc, tag, highlight }, i) => (
        <div class={`reveal reveal-d${i + 1} relative flex flex-col rounded-2xl border p-8 transition-all duration-300 ${
          highlight
            ? "bg-[#F97316] border-[#F97316] shadow-2xl shadow-orange-900/40 scale-[1.02]"
            : "bg-white/5 border-white/10 hover:border-white/20"
        }`}>
          {tag && (
            <div class={`absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
              highlight ? "bg-white text-[#F97316]" : "bg-[#F97316] text-white"
            }`}>
              {tag}
            </div>
          )}

          <div class="mb-6">
            <h3 class={`font-heading font-black text-2xl mb-1 ${highlight ? "text-white" : "text-white"}`}>{name}</h3>
            <p class={`text-sm ${highlight ? "text-orange-100" : "text-slate-400"}`}>{desc}</p>
          </div>

          <!-- Price -->
          <div class="mb-6">
            <span class={`font-heading font-black text-5xl ${highlight ? "text-white" : "text-white"}`}>{price}</span>
            <span class={`text-sm ml-1 ${highlight ? "text-orange-100" : "text-slate-500"}`}>incl. VAT</span>
          </div>

          <!-- Specs -->
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-center gap-3">
              <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-[#F97316]"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}><strong>{count} Xtruders</strong> included</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-[#F97316]"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}>Covers <strong>{range}</strong> diameter</span>
            </li>
            <li class="flex items-center gap-3">
              <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-[#F97316]"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}>Patented 360° coverage</span>
            </li>
          </ul>

          <!-- CTA -->
          <a
            href="https://www.xtrudertools.com/store/"
            target="_blank"
            rel="noopener noreferrer"
            class={`inline-flex items-center justify-center gap-2 font-bold py-3.5 px-6 rounded-xl transition-all duration-200 cursor-pointer text-sm ${
              highlight
                ? "bg-white text-[#F97316] hover:bg-orange-50"
                : "bg-[#F97316] text-white hover:bg-[#EA6C0A]"
            }`}
          >
            Order {name}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      ))}
    </div>

    <!-- Footer note -->
    <p class="text-center text-slate-600 text-sm mt-8 reveal">Free shipping available · Secure checkout at xtrudertools.com</p>
  </div>
</section>
