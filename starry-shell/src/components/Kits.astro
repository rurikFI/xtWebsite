---
import type { Lang } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
---

<section id="kits" class="py-24 bg-[#0F172A] relative overflow-hidden">
  <!-- subtle grid -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid-kits" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid-kits)"/>
    </svg>
  </div>
  <!-- glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[40rem] bg-brand opacity-[0.06] rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-4xl mx-auto px-4 sm:px-6 text-center">

    <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-3 block reveal">Order</span>
    <h2 class="font-heading text-4xl md:text-5xl font-black text-white mb-6 leading-tight reveal">
      Every kit is <span class="text-gradient">built for you</span>
    </h2>
    <p class="text-slate-400 text-lg max-w-2xl mx-auto mb-10 reveal reveal-d1">
      No standard sizes. No guesswork. You tell us the exact diameters you need — we build each Xtruder to match. Order as many as you need and unlock volume pricing along the way.
    </p>

    <!-- Tier summary -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-12 reveal reveal-d2">
      {[
        ['1–2 units',   '€29.99/u', ''],
        ['3–5 units',   '€26.99/u', '10% off'],
        ['6–9 units',   '€22.49/u', '25% off'],
        ['10–20 units', '€20.99/u', 'Best deal'],
      ].map(([range, price, badge]) => (
        <div class={`rounded-xl border p-4 text-center ${badge === 'Best deal' ? 'bg-brand/10 border-brand/40' : 'bg-white/[0.03] border-white/10'}`}>
          <p class={`text-xs font-semibold mb-1 ${badge === 'Best deal' ? 'text-brand' : 'text-slate-400'}`}>{range}</p>
          <p class={`font-bold text-lg ${badge === 'Best deal' ? 'text-brand' : 'text-white'}`}>{price}</p>
          {badge && <p class={`text-xs mt-1 ${badge === 'Best deal' ? 'text-brand font-semibold' : 'text-green-400'}`}>{badge}</p>}
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal reveal-d3">
      <a
        href="/build-your-kit"
        class="inline-flex items-center gap-3 bg-brand hover:bg-brand-hover text-white font-bold text-lg px-10 py-5 rounded-2xl transition-all duration-200 shadow-xl shadow-orange-900/30 hover:shadow-orange-900/50 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Build Your Kit
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <p class="text-slate-600 text-sm mt-4">Secure checkout via Stripe · Ships worldwide</p>
    </div>

  </div>
</section>
