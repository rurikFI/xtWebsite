---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].kits;

const kitsData = [
  { price: "€69.90",  range: "2–15 mm", count: 6,  highlight: false },
  { price: "€109.90", range: "6–35 mm", count: 9,  highlight: true  },
  { price: "€149.90", range: "2–54 mm", count: 13, highlight: false },
];
---

<section id="kits" class="py-24 bg-[#0F172A] relative overflow-hidden">
  <!-- subtle grid -->
  <div class="absolute inset-0 opacity-[0.05] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid-kits" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid-kits)"/>
    </svg>
  </div>

  <div class="relative max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Header -->
    <div class="text-center mb-14 reveal">
      <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-3 block">{t.label}</span>
      <h2 class="font-heading text-4xl md:text-5xl font-black text-white mb-4 leading-tight">
        {t.h2} <span class="text-gradient">{t.h2accent}</span>
      </h2>
      <p class="text-slate-400 text-lg max-w-xl mx-auto">
        {t.body}
      </p>
    </div>

    <!-- Cards -->
    <div class="grid md:grid-cols-3 gap-6">
      {kitsData.map(({ price, range, count, highlight }, i) => {
        const kit = t.kits[i];
        return (
          <div class={`kit-card reveal reveal-d${i + 1} relative flex flex-col rounded-2xl border p-8 ${
            highlight
              ? "kit-card-highlight bg-brand border-brand shadow-2xl shadow-orange-900/40 scale-[1.02]"
              : "bg-white/5 border-white/10"
          }`}>
            {kit.tag && (
              <div class={`absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${
                highlight ? "bg-white text-brand" : "bg-brand text-white"
              }`}>
                {kit.tag}
              </div>
            )}

            <div class="mb-6">
              <h3 class={`font-heading font-black text-2xl mb-1 ${highlight ? "text-white" : "text-white"}`}>{kit.name}</h3>
              <p class={`text-sm ${highlight ? "text-orange-100" : "text-slate-400"}`}>{kit.desc}</p>
            </div>

            <!-- Price -->
            <div class="mb-6">
              <span class={`font-heading font-black text-5xl ${highlight ? "text-white" : "text-white"}`}>{price}</span>
              <span class={`text-sm ml-1 ${highlight ? "text-orange-100" : "text-slate-500"}`}>{t.inclVAT}</span>
            </div>

            <!-- Specs -->
            <ul class="space-y-3 mb-8 flex-1">
              <li class="flex items-center gap-3">
                <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-brand"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}><strong>{count} Xtruders</strong> {t.included}</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-brand"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}>{t.covers} <strong>{range}</strong> {t.diameter}</span>
              </li>
              <li class="flex items-center gap-3">
                <svg class={`w-5 h-5 flex-shrink-0 ${highlight ? "text-white" : "text-brand"}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span class={`text-sm ${highlight ? "text-white" : "text-slate-300"}`}>{t.coverage}</span>
              </li>
            </ul>

            <!-- CTA -->
            <a
              href="https://www.xtrudertools.com/store/"
              target="_blank"
              rel="noopener noreferrer"
              class={`inline-flex items-center justify-center gap-2 font-bold py-3.5 px-6 rounded-xl transition-all duration-200 cursor-pointer text-sm ${
                highlight
                  ? "bg-white text-brand hover:bg-orange-50"
                  : "bg-brand text-white hover:bg-brand-hover"
              }`}
            >
              {t.order} {kit.name}
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        );
      })}
    </div>

    <!-- Footer note -->
    <p class="text-center text-slate-600 text-sm mt-8 reveal">{t.footnote}</p>
  </div>
</section>

<style>
/*
  The lift eases in via the CSS transition (0.65s).
  The wobble animation has a matching 0.65s delay so it only
  kicks in after the card has fully risen — no snap.
  On mouse-leave the browser uses the last animated position
  as the transition start, so the card floats back down smoothly.
*/
@keyframes kit-wobble {
  0%   { transform: translateY(-6px) translateX(0px)    rotate(0deg); }
  25%  { transform: translateY(-8px) translateX(2px)    rotate(0.3deg); }
  52%  { transform: translateY(-6px) translateX(0.5px)  rotate(-0.18deg); }
  76%  { transform: translateY(-8px) translateX(-2px)   rotate(0.28deg); }
  100% { transform: translateY(-6px) translateX(0px)    rotate(0deg); }
}

.kit-card {
  will-change: transform;
  cursor: default;
  transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              box-shadow 0.45s ease,
              border-color 0.25s ease;
}

.kit-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.38), 0 8px 18px rgba(0, 0, 0, 0.18);
  animation: kit-wobble 6s ease-in-out 0.65s infinite;
}

.kit-card-highlight:hover {
  transform: translateY(-6px);
  box-shadow: 0 24px 50px rgba(232, 73, 12, 0.4), 0 8px 18px rgba(232, 73, 12, 0.2);
  animation: kit-wobble 6s ease-in-out 0.65s infinite;
}

@media (prefers-reduced-motion: reduce) {
  .kit-card { transition: box-shadow 0.3s ease; }
  .kit-card:hover { animation: none; transform: none; }
}
</style>
