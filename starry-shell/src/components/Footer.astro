---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].footer;
---

<footer class="bg-black py-12 border-t border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-x-16 gap-y-10 mb-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src="/favicon.webp" alt="" class="h-8 w-8 rounded-md object-cover flex-shrink-0 self-center" />
          <img src="/logo.png" alt="Xtruder™" class="h-8 w-auto" />
        </div>
        <p class="text-slate-500 text-sm leading-relaxed">
          {t.tagline1}<br/>{t.tagline2}
        </p>
        <p class="text-slate-700 text-xs mt-3">&copy; {new Date().getFullYear()} Xtruder Tools AB. {t.copyright}</p>
      </div>

      <!-- Product links -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">{t.productLabel}</h4>
        <ul class="space-y-2">
          {t.productLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">{t.companyLabel}</h4>
        <ul class="space-y-2">
          {t.companyLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer"
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">{t.legalLabel}</h4>
        <ul class="space-y-2">
          {t.legalLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-slate-700 text-xs">{t.bottomText}</p>
      <div class="flex items-center gap-2">
        <div class="w-5 h-3.5 rounded-sm overflow-hidden flex-shrink-0">
          <svg viewBox="0 0 18 11" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <rect width="18" height="11" fill="white"/>
            <rect y="4" width="18" height="3" fill="#003580"/>
            <rect x="5" width="3" height="11" fill="#003580"/>
          </svg>
        </div>
        <span class="text-slate-600 text-xs">{t.madeIn}</span>
      </div>
    </div>

  </div>
</footer>
