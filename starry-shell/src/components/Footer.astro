---
const productLinks = [
  { href: "#how-it-works", label: "How It Works" },
  { href: "#features", label: "Features" },
  { href: "#for-you", label: "Who It's For" },
  { href: "#materials", label: "Compatible Materials" },
];

const companyLinks = [
  { href: "https://www.xtrudertools.com", label: "Visit Store", external: true },
  { href: "/about-us/", label: "About Us", external: false },
  { href: "/contact-us/", label: "Contact Us", external: false },
];

const legalLinks = [
  { href: "/privacy-policy/", label: "Privacy Policy" },
  { href: "/terms-conditions/", label: "Terms & Conditions" },
  { href: "/return-policy/", label: "Return Policy" },
  { href: "/shipping-policy/", label: "Shipping Policy" },
  { href: "/warranty/", label: "Warranty" },
  { href: "/patent/", label: "Patent" },
];
---

<footer class="bg-black py-12 border-t border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-x-16 gap-y-10 mb-10">
      <!-- Brand -->
      <div>
        <div class="flex items-center gap-2 mb-4">
          <img src="/favicon.webp" alt="" class="h-8 w-8 rounded-md object-cover flex-shrink-0 self-center" />
          <img src="/logo.png" alt="Xtruder™" class="h-8 w-auto" />
        </div>
        <p class="text-slate-500 text-sm leading-relaxed">
          Innovation in insulation.<br/>Quality from Finland.
        </p>
        <p class="text-slate-700 text-xs mt-3">&copy; {new Date().getFullYear()} Xtruder Tools AB. All rights reserved.</p>
      </div>

      <!-- Product links -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">Product</h4>
        <ul class="space-y-2">
          {productLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">Company</h4>
        <ul class="space-y-2">
          {companyLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer"
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-heading font-bold text-slate-500 text-xs uppercase tracking-widest mb-4">Legal</h4>
        <ul class="space-y-2">
          {legalLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-500 hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p class="text-slate-700 text-xs">Patented technology. Unauthorized reproduction prohibited.</p>
      <div class="flex items-center gap-2">
        <div class="w-5 h-3.5 rounded-sm overflow-hidden flex-shrink-0">
          <svg viewBox="0 0 18 11" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <rect width="18" height="11" fill="white"/>
            <rect y="4" width="18" height="3" fill="#003580"/>
            <rect x="5" width="3" height="11" fill="#003580"/>
          </svg>
        </div>
        <span class="text-slate-600 text-xs">Made in Finland</span>
      </div>
    </div>

  </div>
</footer>
