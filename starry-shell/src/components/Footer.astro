---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].footer;
const cookieSettingsLabel = translations[lang].cookieBanner.footerLink;
---

<footer class="bg-white dark:bg-black py-12 border-t border-slate-200 dark:border-slate-800/60 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-3 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr] gap-x-4 sm:gap-x-16 gap-y-8 sm:gap-y-10 mb-10">
      <!-- Brand -->
      <div class="col-span-3 sm:col-span-1">
        <div class="flex items-center gap-2 mb-4">
          <img src="/favicon.webp" alt="" class="h-8 w-8 rounded-md object-cover flex-shrink-0 self-center" />
          <img src="/logo.png" alt="Xtruder™" class="h-8 w-auto" style="filter: var(--logo-filter); transform: translateY(-4px)" />
        </div>
        <p class="text-slate-400 dark:text-slate-500 text-sm leading-relaxed">
          {t.tagline1}<br/>{t.tagline2}
        </p>
        <div class="mt-4 space-y-1.5">
          <a href="tel:+358503775332" class="flex items-center gap-2 text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm">
            <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81 19.79 19.79 0 01.19 1.18 2 2 0 012.18 0h3a2 2 0 012 1.72c.13 1.05.37 2.07.7 3.06a2 2 0 01-.45 2.11L6.2 8.12A16 16 0 0015.88 17.8l1.23-1.23a2 2 0 012.11-.45c.99.33 2.01.57 3.06.7A2 2 0 0122 16.92z"/></svg>
            +358 50 377 5332
          </a>
          <a href="mailto:support@xtrudertools.com" class="flex items-center gap-2 text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm">
            <svg class="w-3.5 h-3.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            support@xtrudertools.com
          </a>
        </div>
        <p class="text-slate-400 dark:text-slate-700 text-xs mt-4">&copy; {new Date().getFullYear()} Xtruder Tools AB. {t.copyright}</p>
      </div>

      <!-- Product links -->
      <div>
        <h4 class="font-heading font-bold text-slate-400 dark:text-slate-500 text-xs uppercase tracking-widest mb-4">{t.productLabel}</h4>
        <ul class="space-y-2">
          {t.productLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="font-heading font-bold text-slate-400 dark:text-slate-500 text-xs uppercase tracking-widest mb-4">{t.companyLabel}</h4>
        <ul class="space-y-2">
          {t.companyLinks.map(({ href, label, external }) => (
            <li>
              <a
                href={href}
                class="text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm cursor-pointer"
                {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
              >{label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-heading font-bold text-slate-400 dark:text-slate-500 text-xs uppercase tracking-widest mb-4">{t.legalLabel}</h4>
        <ul class="space-y-2">
          {t.legalLinks.map(({ href, label }) => (
            <li>
              <a href={href} class="text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm cursor-pointer">{label}</a>
            </li>
          ))}
          <li>
            <button
              type="button"
              onclick="window.openCookieSettings()"
              class="text-slate-400 dark:text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors duration-200 text-sm cursor-pointer text-left"
            >
              {cookieSettingsLabel}
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-slate-200 dark:border-slate-800/60 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-slate-400 dark:text-slate-700 text-xs">{t.bottomText}</p>

      <!-- Language switcher -->
      <div class="flex items-center gap-2.5">
        {(['en', 'sv', 'fi'] as const).map((l) => (
          <a
            id={`lang-footer-${l}`}
            href="#"
            title={l === 'en' ? 'English' : l === 'sv' ? 'Svenska' : 'Suomi'}
            class={`w-8 h-5 rounded-sm overflow-hidden border flex-shrink-0 cursor-pointer transition-opacity duration-200 ${
              lang === l
                ? 'border-slate-400/60 dark:border-white/50 ring-2 ring-slate-300/50 dark:ring-white/30 opacity-100'
                : 'border-slate-200 dark:border-white/20 opacity-50 hover:opacity-100'
            }`}
          >
            {l === 'en' && (<svg viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><rect width="60" height="30" fill="#012169"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="white" stroke-width="6"/><path d="M0,0 L60,30 M60,0 L0,30" stroke="#C8102E" stroke-width="4"/><rect x="25" width="10" height="30" fill="white"/><rect y="10" width="60" height="10" fill="white"/><rect x="27" width="6" height="30" fill="#C8102E"/><rect y="12" width="60" height="6" fill="#C8102E"/></svg>)}
            {l === 'sv' && (<svg viewBox="0 0 16 10" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><rect width="16" height="10" fill="#006AA7"/><rect x="5" width="2" height="10" fill="#FECC02"/><rect y="4" width="16" height="2" fill="#FECC02"/></svg>)}
            {l === 'fi' && (<svg viewBox="0 0 18 11" xmlns="http://www.w3.org/2000/svg" class="w-full h-full"><rect width="18" height="11" fill="white"/><rect y="4" width="18" height="3" fill="#003580"/><rect x="5" width="3" height="11" fill="#003580"/></svg>)}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <div class="w-5 h-3.5 rounded-sm overflow-hidden flex-shrink-0">
          <svg viewBox="0 0 18 11" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <rect width="18" height="11" fill="white"/>
            <rect y="4" width="18" height="3" fill="#003580"/>
            <rect x="5" width="3" height="11" fill="#003580"/>
          </svg>
        </div>
        <span class="text-slate-400 dark:text-slate-600 text-xs">{t.madeIn}</span>
      </div>
    </div>

  </div>
</footer>
