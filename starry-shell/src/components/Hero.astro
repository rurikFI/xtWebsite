---
---

<section class="relative min-h-screen bg-[#0F172A] flex items-center overflow-hidden pt-20">
  <!-- Grid texture -->
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>
  <!-- Glows -->
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[32rem] h-[32rem] bg-[#F97316] opacity-[0.08] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 w-64 h-64 bg-blue-600 opacity-[0.05] rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Copy -->
      <div>
        <div class="inline-flex items-center gap-2 bg-[#F97316]/15 border border-[#F97316]/30 rounded-full px-4 py-1.5 mb-6">
          <span class="w-2 h-2 bg-[#F97316] rounded-full animate-pulse"></span>
          <span class="text-[#F97316] text-sm font-semibold">Patented Technology · Made in Finland</span>
        </div>

        <h1 class="font-heading text-5xl lg:text-6xl xl:text-7xl font-black text-white leading-tight mb-6">
          Insulate in a<br/>
          <span class="text-gradient">New, Efficient</span><br/>
          Way.
        </h1>

        <p class="text-slate-300 text-lg lg:text-xl leading-relaxed mb-8 max-w-xl">
          The Xtruder™ is the patented applicator that coats pipes, cables, hoses, ropes, and wires with any material — uniformly, around the full 360° circumference, every single time.
        </p>

        <div class="flex flex-wrap gap-4 mb-10">
          <a href="#cta" class="inline-flex items-center gap-2 bg-[#F97316] hover:bg-[#EA6C0A] text-white font-semibold px-7 py-3.5 rounded-xl transition-colors duration-200 cursor-pointer">
            View Xtruder Kits
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="inline-flex items-center gap-2 text-white border border-white/25 hover:border-white/60 hover:bg-white/5 font-semibold px-7 py-3.5 rounded-xl transition-all duration-200 cursor-pointer">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            See How It Works
          </a>
        </div>

        <div class="flex flex-wrap gap-6 text-sm text-slate-400">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Patented design
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            500+ sizes
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Family business
          </span>
        </div>
      </div>

      <!-- Illustration -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg">
          <svg viewBox="0 0 480 310" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full" style="filter:drop-shadow(0 0 30px rgba(249,115,22,0.15))">
            <defs>
              <linearGradient id="coatGrad" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0%" stop-color="#F97316" stop-opacity="0.8"/>
                <stop offset="100%" stop-color="#F97316" stop-opacity="0"/>
              </linearGradient>
              <linearGradient id="pipeGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#475569"/>
                <stop offset="40%" stop-color="#334155"/>
                <stop offset="100%" stop-color="#1E293B"/>
              </linearGradient>
            </defs>
            <!-- Shadow -->
            <ellipse cx="240" cy="240" rx="190" ry="16" fill="#000" opacity="0.2"/>
            <!-- Pipe body -->
            <rect x="20" y="125" width="440" height="72" rx="4" fill="url(#pipeGrad)"/>
            <rect x="20" y="125" width="440" height="12" rx="4" fill="#64748B" opacity="0.6"/>
            <ellipse cx="20" cy="161" rx="10" ry="36" fill="#1E293B"/>
            <ellipse cx="20" cy="161" rx="6" ry="28" fill="#0F172A"/>
            <ellipse cx="460" cy="161" rx="10" ry="36" fill="#1E293B"/>
            <ellipse cx="460" cy="161" rx="6" ry="28" fill="#0F172A"/>
            <!-- Coated section -->
            <rect x="20" y="125" width="175" height="72" fill="#F97316" opacity="0.75"/>
            <rect x="20" y="125" width="175" height="10" fill="#FBBF24" opacity="0.5"/>
            <rect x="168" y="125" width="36" height="72" fill="url(#coatGrad)"/>
            <ellipse cx="20" cy="161" rx="10" ry="36" fill="#F97316" opacity="0.75"/>
            <!-- Xtruder tool -->
            <rect x="198" y="108" width="84" height="106" rx="8" fill="#1E293B" stroke="#F97316" stroke-width="2.5"/>
            <rect x="203" y="113" width="74" height="96" rx="6" fill="#0F172A"/>
            <line x1="203" y1="140" x2="277" y2="140" stroke="#1E293B" stroke-width="1.5"/>
            <line x1="203" y1="155" x2="277" y2="155" stroke="#1E293B" stroke-width="1.5"/>
            <line x1="203" y1="170" x2="277" y2="170" stroke="#1E293B" stroke-width="1.5"/>
            <line x1="203" y1="185" x2="277" y2="185" stroke="#1E293B" stroke-width="1.5"/>
            <rect x="198" y="155" width="4" height="12" rx="2" fill="#F97316"/>
            <rect x="278" y="155" width="4" height="12" rx="2" fill="#F97316"/>
            <!-- Material tube -->
            <rect x="226" y="42" width="28" height="72" rx="6" fill="#334155"/>
            <rect x="228" y="42" width="24" height="8" rx="4" fill="#475569"/>
            <rect x="227" y="56" width="26" height="42" rx="3" fill="#F97316" opacity="0.25"/>
            <text x="240" y="82" fill="#F97316" font-size="7" font-family="Rubik" font-weight="700" text-anchor="middle" letter-spacing="0.5">MATERIAL</text>
            <!-- Handle -->
            <rect x="282" y="153" width="52" height="16" rx="8" fill="#334155"/>
            <rect x="316" y="148" width="22" height="26" rx="6" fill="#475569"/>
            <line x1="320" y1="152" x2="320" y2="170" stroke="#64748B" stroke-width="1.5"/>
            <line x1="325" y1="152" x2="325" y2="170" stroke="#64748B" stroke-width="1.5"/>
            <line x1="330" y1="152" x2="330" y2="170" stroke="#64748B" stroke-width="1.5"/>
            <!-- Direction arrow -->
            <path d="M 345 68 L 410 68" stroke="#F97316" stroke-width="2" stroke-dasharray="5 3"/>
            <polygon points="408,63 418,68 408,73" fill="#F97316"/>
            <text x="374" y="58" fill="#F97316" font-size="9" font-family="Rubik" font-weight="600" text-anchor="middle" letter-spacing="0.5">DIRECTION</text>
            <!-- 360° badge -->
            <circle cx="420" cy="115" r="28" fill="#1E293B" stroke="#F97316" stroke-width="2"/>
            <text x="420" y="111" fill="#F97316" font-size="11" font-family="Rubik" font-weight="800" text-anchor="middle">360°</text>
            <text x="420" y="124" fill="#94A3B8" font-size="8" font-family="Rubik" text-anchor="middle">COVERAGE</text>
            <!-- Labels -->
            <text x="90" y="102" fill="#F97316" font-size="11" font-family="Rubik" font-weight="700" text-anchor="middle">COATED</text>
            <line x1="90" y1="105" x2="90" y2="124" stroke="#F97316" stroke-width="1.5" stroke-dasharray="3 2" opacity="0.7"/>
            <text x="360" y="102" fill="#94A3B8" font-size="11" font-family="Rubik" font-weight="700" text-anchor="middle">UNCOATED</text>
            <line x1="360" y1="105" x2="360" y2="124" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="3 2" opacity="0.7"/>
            <text x="240" y="264" fill="#94A3B8" font-size="12" font-family="Rubik" font-weight="600" text-anchor="middle" letter-spacing="1.5">THE XTRUDER™</text>
            <line x1="200" y1="258" x2="225" y2="245" stroke="#94A3B8" stroke-width="1" stroke-dasharray="3 2" opacity="0.5"/>
          </svg>

          <div class="absolute -top-3 -right-2 bg-[#F97316] text-white text-xs font-black px-3 py-1.5 rounded-full shadow-lg tracking-wide">PATENTED</div>
          <div class="absolute bottom-10 -left-3 bg-[#1E293B] border border-slate-600/40 text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-lg flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 bg-green-400 rounded-full"></span>500+ Sizes
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500">
    <span class="text-xs">Scroll to explore</span>
    <div class="w-5 h-8 border border-slate-700 rounded-full flex items-start justify-center p-1">
      <div class="w-1 h-2 bg-[#F97316] rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
