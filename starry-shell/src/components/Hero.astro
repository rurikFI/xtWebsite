---
---

<section class="relative min-h-screen bg-[#0F172A] flex items-center overflow-hidden pt-20">
  <!-- Grid texture -->
  <div class="absolute inset-0 opacity-[0.07] pointer-events-none">
    <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
          <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#64748B" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>
  <!-- Glows -->
  <div class="absolute top-1/2 right-1/4 -translate-y-1/2 w-[32rem] h-[32rem] bg-[#F97316] opacity-[0.08] rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/4 w-64 h-64 bg-blue-600 opacity-[0.05] rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Copy -->
      <div>
        <div class="inline-flex items-center gap-2 bg-[#F97316]/15 border border-[#F97316]/30 rounded-full px-4 py-1.5 mb-6">
          <span class="w-2 h-2 bg-[#F97316] rounded-full animate-pulse"></span>
          <span class="text-[#F97316] text-sm font-semibold">Patented Technology · Made in Finland</span>
        </div>

        <h1 class="font-heading text-5xl lg:text-6xl xl:text-7xl font-black text-white leading-tight mb-6">
          Insulate in a<br/>
          <span class="text-gradient">New, Efficient</span><br/>
          Way.
        </h1>

        <p class="text-slate-300 text-lg lg:text-xl leading-relaxed mb-8 max-w-xl">
          The Xtruder™ is the patented applicator that coats pipes, cables, hoses, ropes, and wires with any material — uniformly, around the full 360° circumference, every single time.
        </p>

        <div class="flex flex-wrap gap-4 mb-10">
          <a href="#cta" class="inline-flex items-center gap-2 bg-[#F97316] hover:bg-[#EA6C0A] text-white font-semibold px-7 py-3.5 rounded-xl transition-colors duration-200 cursor-pointer">
            View Xtruder Kits
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="#how-it-works" class="inline-flex items-center gap-2 text-white border border-white/25 hover:border-white/60 hover:bg-white/5 font-semibold px-7 py-3.5 rounded-xl transition-all duration-200 cursor-pointer">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            See How It Works
          </a>
        </div>

        <div class="flex flex-wrap gap-6 text-sm text-slate-400">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Patented design
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
            500+ sizes
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#F97316]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            Family business
          </span>
        </div>
      </div>

      <!-- Video -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg">

          <!-- Outer glow -->
          <div class="absolute -inset-3 bg-[#F97316] opacity-[0.45] rounded-3xl blur-2xl pointer-events-none"></div>

          <!-- Frame -->
          <div class="relative rounded-2xl overflow-hidden border border-[#F97316]/30 shadow-2xl shadow-black/60"
               style="background: #0a1120;">

            <!-- Corner accents -->
            <div class="absolute top-0 left-0 w-6 h-6 border-t-2 border-l-2 border-[#F97316] rounded-tl-2xl z-10 pointer-events-none"></div>
            <div class="absolute top-0 right-0 w-6 h-6 border-t-2 border-r-2 border-[#F97316] rounded-tr-2xl z-10 pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-6 h-6 border-b-2 border-l-2 border-[#F97316] rounded-bl-2xl z-10 pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-6 h-6 border-b-2 border-r-2 border-[#F97316] rounded-br-2xl z-10 pointer-events-none"></div>

            <!-- Top bar -->
            <div class="flex items-center gap-1.5 px-4 py-2.5 border-b border-white/10 bg-white/[0.03]">
              <span class="w-2.5 h-2.5 rounded-full bg-[#F97316]/60"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-slate-600"></span>
              <span class="ml-auto text-[10px] font-mono text-slate-500 tracking-widest uppercase">Xtruder™ · Demo</span>
            </div>

            <video
              autoplay
              loop
              muted
              playsinline
              class="w-full block"
            >
              <source src="/hero-video.mp4" type="video/mp4" />
            </video>
          </div>

          <!-- Floating badges -->
          <div class="absolute -top-3 -right-2 bg-[#F97316] text-white text-xs font-black px-3 py-1.5 rounded-full shadow-lg tracking-wide z-20">PATENTED</div>
        </div>
      </div>

    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-500">
    <span class="text-xs">Scroll to explore</span>
    <div class="w-5 h-8 border border-slate-700 rounded-full flex items-start justify-center p-1">
      <div class="w-1 h-2 bg-[#F97316] rounded-full animate-bounce"></div>
    </div>
  </div>
</section>
