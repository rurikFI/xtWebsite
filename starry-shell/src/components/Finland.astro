---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].finland;
---

<section class="py-24 bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
    <div class="reveal">

      <!-- Finnish flag accent -->
      <div class="flex items-center justify-center gap-4 mb-8">
        <div class="h-px bg-gradient-to-r from-transparent to-blue-700 w-20"></div>
        <div class="w-14 h-9 rounded-md overflow-hidden border border-slate-200 shadow-sm flex-shrink-0">
          <svg viewBox="0 0 18 11" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <rect width="18" height="11" fill="white"/>
            <rect y="4" width="18" height="3" fill="#003580"/>
            <rect x="5" width="3" height="11" fill="#003580"/>
          </svg>
        </div>
        <div class="h-px bg-gradient-to-l from-transparent to-blue-700 w-20"></div>
      </div>

      <span class="text-brand font-semibold text-sm uppercase tracking-widest mb-4 block">{t.label}</span>
      <h2 class="font-heading text-4xl md:text-5xl font-black text-slate-900 mb-6 leading-tight">
        {t.h2}<br/><span class="text-blue-700">{t.h2sub}</span>
      </h2>
      <p class="text-slate-500 text-lg leading-relaxed max-w-2xl mx-auto mb-12">
        {t.body}
      </p>

      <div class="grid sm:grid-cols-3 gap-6 text-left">
        {t.stats.map(({ value, label, desc }, i) => (
          <div class={`card-hover bg-white rounded-2xl p-6 border border-slate-100 shadow-sm reveal reveal-d${i + 1}`}>
            <div class="font-heading font-black text-4xl text-brand mb-2">{value}</div>
            <div class="font-heading font-semibold text-slate-900 mb-1">{label}</div>
            <p class="text-slate-500 text-sm">{desc}</p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
