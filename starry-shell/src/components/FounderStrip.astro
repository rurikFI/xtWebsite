---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].founderStrip;
---

<section class="py-20 bg-orange-50/50 dark:bg-white/[0.02] border-y border-orange-100 dark:border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center reveal">

      <!-- LEFT: headline + quote + grounding + CTA -->
      <div>
        <!-- Headline -->
        <p class="text-brand font-extrabold text-sm uppercase tracking-widest mb-6 leading-snug max-w-xs">
          {t.headline}
        </p>

        <!-- Quote -->
        <blockquote class="relative mb-6">
          <!-- decorative opening quote mark -->
          <span class="absolute -top-4 -left-2 text-brand/20 dark:text-brand/15 font-heading font-black text-8xl leading-none select-none" aria-hidden="true">"</span>
          <p class="relative font-heading text-2xl md:text-3xl font-black text-slate-900 dark:text-white leading-snug italic">
            {t.quote}
          </p>
        </blockquote>

        <!-- Attribution -->
        <p class="text-brand font-semibold text-sm mb-6">{t.attribution}</p>

        <!-- Grounding sentence -->
        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed mb-8">
          {t.grounding}
        </p>

        <!-- CTA -->
        <a
          href={t.ctaHref}
          class="inline-flex items-center gap-2 text-brand hover:text-brand-hover font-bold text-sm transition-colors duration-200 group"
        >
          {t.cta}
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- RIGHT: founder cards -->
      <div class="flex gap-5 justify-center lg:justify-end">
        {t.founders.map(({ name, role }) => (
          <div class="flex flex-col items-center gap-3 bg-white dark:bg-white/[0.04] border border-orange-100 dark:border-white/[0.08] rounded-2xl px-6 py-7 shadow-sm w-40 sm:w-44">

            <!-- Avatar placeholder -->
            <div class="w-20 h-20 rounded-full bg-orange-50 dark:bg-white/[0.06] border-2 border-orange-200 dark:border-white/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-10 h-10 text-brand/40 dark:text-brand/30" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z"/>
              </svg>
            </div>

            <!-- Name + role -->
            <div class="text-center">
              <p class="font-heading font-black text-slate-900 dark:text-white text-sm leading-tight">{name}</p>
              <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 leading-snug">{role}</p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>
