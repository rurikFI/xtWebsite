---
import type { Lang } from '../i18n/translations';
import { translations } from '../i18n/translations';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = translations[lang].founderStrip;
---

<section class="py-20 bg-orange-50/50 dark:bg-white/[0.02] border-y border-orange-100 dark:border-white/[0.06]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center reveal">

      <!-- LEFT: headline + quote + grounding + CTA -->
      <div>
        <!-- Headline -->
        <p class="text-slate-900 dark:text-white font-extrabold text-lg md:text-xl mb-6 leading-snug">
          {t.headline}
        </p>

        <!-- Quote -->
        <blockquote class="relative mb-6">
          <!-- decorative opening quote mark -->
          <span class="absolute -top-3 -left-1 text-brand/60 dark:text-brand/50 font-heading font-black text-6xl md:text-8xl leading-none select-none" aria-hidden="true">"</span>
          <p class="relative font-heading text-xl md:text-3xl font-black text-slate-900 dark:text-white leading-snug italic">
            {t.quote}
          </p>
        </blockquote>

        <!-- Attribution -->
        <p class="text-brand font-semibold text-sm mb-6">{t.attribution}</p>

        <!-- Grounding sentence -->
        <p class="text-slate-600 dark:text-slate-400 text-base leading-relaxed mb-8">
          {t.grounding}
        </p>

        <!-- CTA -->
        <a
          href={t.ctaHref}
          class="inline-flex items-center gap-2 text-brand hover:text-brand-hover font-bold text-sm transition-colors duration-200 group"
        >
          {t.cta}
          <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <!-- RIGHT: founder cards -->
      <div class="flex gap-5 justify-center lg:justify-end">
        {t.founders.map(({ name, role, relation }) => (
          <div class="flex flex-col items-center gap-3 bg-white dark:bg-white/[0.04] border border-orange-100 dark:border-white/[0.08] rounded-2xl px-5 py-6 sm:px-8 sm:py-9 shadow-sm flex-1 sm:flex-none sm:w-48 lg:w-52">

            <!-- Avatar -->
            <div class="w-24 h-24 rounded-full border-2 border-orange-200 dark:border-white/10 flex-shrink-0 overflow-hidden">
              {name.startsWith('Patrik') ? (
                <img src="/patrik-founder.jpg" alt={name} class="w-full h-full object-cover object-[center_25%]" />
              ) : (
                <img src="/rurik-founder.jpg" alt={name} class="w-full h-full object-cover object-[center_20%] scale-125" />
              )}
            </div>

            <!-- Name + role -->
            <div class="text-center">
              <p class="font-heading font-black text-slate-900 dark:text-white text-sm leading-tight">{name}</p>
              <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 leading-snug">{role}</p>
              <p class="text-brand font-bold text-xs mt-1">{relation}</p>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</section>
