---
const items = [
  {
    label: "Patented Technology",
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
  },
  {
    label: "500+ Sizes Available",
    icon: `<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>`,
  },
  {
    label: "Made in Finland",
    icon: `<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
  {
    label: "Finnish Family Business",
    icon: `<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>`,
  },
];
---

<section class="bg-[#F97316] py-5">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-14">
      {items.map(({ label, icon }) => (
        <div class="flex items-center gap-2.5 text-white">
          <svg class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
          <span class="font-heading font-bold text-sm">{label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
